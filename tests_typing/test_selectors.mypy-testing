import attrs
import pytest

from web_poet import (
    HttpResponse,
    WebPage,
    css,
    css_get,
    css_getall,
    field,
    jmespath_get,
    jmespath_getall,
    xpath_get,
)


@attrs.define
class Page(WebPage):
    name = field(css_get("h1::text"))
    price = field(css_get(".price::text"))
    brand = field(xpath_get("//meta[@itemprop='brand']/@content"))
    images = field(css_getall("img::attr(src)"))
    length = field(css_get("h1::text"), out=[len])

    json = field(jmespath_get("price"))
    jsons = field(jmespath_getall("tags"))

    helper = css_get(".sku::text")
    helpers = css_getall(".sku::text")
    helper_selector = css(".sku::text")


@pytest.mark.mypy_testing
def test_field_str() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.name)  # R: Union[builtins.str, None]


@pytest.mark.mypy_testing
def test_field_css() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.price)  # R: Union[builtins.str, None]


@pytest.mark.mypy_testing
def test_field_xpath() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.brand)  # R: Union[builtins.str, None]


@pytest.mark.mypy_testing
def test_field_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.images)  # R: builtins.list[builtins.str]


@pytest.mark.mypy_testing
def test_field_jmespath() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.json)  # R: Any


@pytest.mark.mypy_testing
def test_field_jmespath_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.jsons)  # R: builtins.list[Any]


@pytest.mark.mypy_testing
def test_declaration() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.helper)  # R: Union[builtins.str, None]


@pytest.mark.mypy_testing
def test_declaration_all() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.helpers)  # R: builtins.list[builtins.str]


@pytest.mark.mypy_testing
def test_declaration_selector() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.helper_selector)  # R: parsel.selector.SelectorList[parsel.selector.Selector]


@pytest.mark.mypy_testing
@pytest.mark.xfail(reason="mypy does not infer field(out=...) transformed return type")
def test_field_out() -> None:
    page = Page(response=HttpResponse("http://example.com", b""))
    reveal_type(page.length)  # R: builtins.int
